# Ignore everything by default
/*

# Explicitly allow top-level dotfiles
!/.zshrc
!/.p10k.zsh
!/.clang-format
!/.xinitrc
!/.gitignore
!/README.md
!/install.sh
!/fonts
!/.oh-my-zsh
!/.dialogrc
!/.Xresources

# Allow Scripts, but block its contents by default too
!/Scripts
/Scripts/*
!/Scripts/User-Scripts
/Scripts/User-Scripts/*

# Only re-allow the specific script folders you actually use
!/Scripts/User-Scripts/Tmux-Scripts
!/Scripts/User-Scripts/System-Scripts
!/Scripts/User-Scripts/Qutebrowser-Scripts
!/Scripts/User-Scripts/Programming-Scripts
!/Scripts/User-Scripts/Github-Scripts
!/Scripts/User-Scripts/Download-Scripts

!/Scripts/User-Scripts/Kindle
/Scripts/User-Scripts/Kindle/*
!/Scripts/User-Scripts/Kindle/kindle-sync.env.example
!/Scripts/User-Scripts/Kindle/*.sh

!/Other
/Other/*
!/Other/themes
/Other/themes/*

# Only re-allow the specific theme folders, skip the wallpaper images
!/Other/themes/catppuccin_frappe
!/Other/themes/catppuccin_latte
!/Other/themes/catppuccin_macchiato
!/Other/themes/catppuccin_mocha
!/Other/themes/everforest_dark
!/Other/themes/everforest_light
!/Other/themes/gruvbox_dark
!/Other/themes/gruvbox_light
!/Other/themes/tokyonight-moon

# Allow .config, but block its contents by default too
!/.config
/.config/*

# Only re-allow the specific app configs you actually rice
!/.config/awesome
!/.config/bat
!/.config/btop
!/.config/dunst
!/.config/fastfetch
!/.config/mpv
!/.config/nvim
!/.config/polybar
!/.config/qutebrowser
!/.config/ranger
!/.config/rofi
!/.config/systemd
